# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram IDs of administrators, separated by comma (e.g. 12345678,87654321)
# If empty, anyone can create and manage pairs
ADMIN_IDS=

# Path to SQLite database file
DB_PATH=data/bot.db

# Allow any user to add lessons regardless of ADMIN_IDS (true/false)
ALLOW_ANYONE_CREATE_LESSONS=true

# Schedule ICS calendar URL for auto-syncing laboratories
SCHEDULE_ICS_URL=https://stud.l9labs.ru/ics/772107317.ics

# Default slots per laboratory subgroup
DEFAULT_LAB_SLOTS=15

# Periodic sync interval in hours
SYNC_INTERVAL_HOURS=6
